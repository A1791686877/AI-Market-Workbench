# Copy this file to E:\AI-Market-Workbench\config\providers.env.
# Never paste values into chat, source files, logs, or Git.
# These credentials are used only by allowlisted market-data GET adapters.
ALPACA_MARKET_DATA_KEY_ID=
ALPACA_MARKET_DATA_SECRET=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
TIINGO_API_TOKEN=
MASSIVE_API_KEY=
COINGECKO_DEMO_API_KEY=

# SEC asks for an identifying User-Agent, for example:
# AI-Market-Workbench YourName your-email@example.com
SEC_USER_AGENT=
