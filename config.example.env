# Copy only to E:\AI-Market-Workbench\.env if a read-only provider is enabled.
# Never commit real values. The default fixture mode requires no credentials.
AMW_DATA_MODE=fixture
AMW_NETWORK_ENABLED=false
AMW_CRYPTO_PROVIDER=okx
AMW_MARKET_CACHE_TTL_SECONDS=300
AMW_ROOT=E:\AI-Market-Workbench

# Real LLM option through the already authenticated Codex CLI. This consumes
# Codex/ChatGPT quota; it is not a USD 0 guarantee and is separate from data cost.
AMW_CODEX_COMMAND=codex
AMW_CODEX_MODEL=gpt-5.6-terra
AMW_CODEX_TIMEOUT_SECONDS=300

# Optional market-data-only credentials. No trading base URL is accepted.
ALPACA_MARKET_DATA_KEY_ID=
ALPACA_MARKET_DATA_SECRET=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
TIINGO_API_TOKEN=
MASSIVE_API_KEY=
COINGECKO_DEMO_API_KEY=

# SEC requires an identifying User-Agent before live calls are enabled.
SEC_USER_AGENT=AI-Market-Workbench admin@example.invalid
